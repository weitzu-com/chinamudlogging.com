    "test:funnel": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.8",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
