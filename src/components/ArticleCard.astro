---
interface Article {
  title: string;
  slug: string;
  summary: string;
  image: string;
  publishedAt: string;
}

const { article, heading = "h3" } = Astro.props as { article: Article; heading?: "h2" | "h3" };
const Heading = heading;
const date = new Date(`${article.publishedAt.replace(" ", "T")}Z`);
---

<article class="article-card">
  <a href={`/${article.slug}/`} tabindex="-1" aria-hidden="true">
    <img src={article.image} alt="" width="720" height="460" loading="lazy" />
  </a>
  <div class="article-card-body">
    <time datetime={article.publishedAt}>{date.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })}</time>
    <Heading><a href={`/${article.slug}/`}>{article.title}</a></Heading>
    <p>{article.summary}</p>
    <a class="text-link" href={`/${article.slug}/`}>Read article →</a>
  </div>
</article>
