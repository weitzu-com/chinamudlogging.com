{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "chinamudlogging.com" }],
      "destination": "https://www.chinamudlogging.com/:path*",
      "permanent": true
    },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/shop/", "destination": "/product/", "permanent": true },
    { "source": "/news/", "destination": "/blog/", "permanent": true },
    { "source": "/what-we-can-do/", "destination": "/services/", "permanent": true },
    { "source": "/why-choose-us/", "destination": "/about-us/", "permanent": true },
    { "source": "/cart/", "destination": "/contact-us/", "permanent": true },
    { "source": "/checkout/", "destination": "/contact-us/", "permanent": true },
    { "source": "/my-account/", "destination": "/contact-us/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
